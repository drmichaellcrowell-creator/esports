# =============================================================================
# Backend configuration — NAMES AND PLACEHOLDERS ONLY.
# Copy to backend/.env and fill in locally. Never commit a filled-in file.
# =============================================================================

NODE_ENV=development
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# API database identity.
#
# Least-privileged application role. Amendment 001 database invariant I12: this
# role must hold NO INSERT on the organization or authorization-policy-version
# tables. It is NOT the provisioner and NOT the Supabase service role.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# -----------------------------------------------------------------------------
# Provisioner database identity — SEPARATE CREDENTIAL.
#
# Used only by operator-invoked provisioning entrypoints (`policy.bootstrap`,
# `organization.provision` — Phase 0B). Must differ from DATABASE_URL; startup
# refuses the two being equal. The API process must never be given this value.
# Leave unset for API and worker processes.
# -----------------------------------------------------------------------------
# PROVISIONER_DATABASE_URL=postgresql://PROVISIONER_USER:PASSWORD@HOST:5432/DATABASE

# -----------------------------------------------------------------------------
# Supabase Auth — identity verification only.
#
# Supabase Auth authenticates users. It is NOT the authorization source: the
# `role` and `app_metadata` claims are never consulted (Contract Global
# Invariant 5). Authorization comes from application-owned Membership,
# RoleAssignment, CoachScopeAssignment and CaptainAssignment.
#
# No Supabase service-role key appears here, and none belongs in the frontend.
# -----------------------------------------------------------------------------
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated

# -----------------------------------------------------------------------------
# Process configuration
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8080
WORKER_HEARTBEAT_INTERVAL_MS=30000

# -----------------------------------------------------------------------------
# Tests only. When set, the integration suite uses this PostgreSQL instead of
# starting a Testcontainers one. Never point this at a real environment.
# -----------------------------------------------------------------------------
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
