# =============================================================================
# Backend configuration — NAMES AND PLACEHOLDERS ONLY.
# Copy to backend/.env and fill in locally. Never commit a filled-in file.
#
# FOUR SEPARATE DATABASE AUTHORITIES (migration 0001). Keeping them separate is
# a contract requirement, not a convention:
#
#   app_owner        owns the app schema. No login, never in a connection string.
#   app_migrator     applies migrations.
#   app_api          API and worker runtime identity. Least privilege.
#   app_provisioner  operator-only genesis authority (Phase 0C).
#
# Startup refuses a DATABASE_URL that connects as app_provisioner, app_migrator
# or app_owner, and refuses any two of these URLs being identical.
#
# CONNECTION MODE: use SESSION-mode pooling (port 5432 on the pooler host), not
# transaction mode (port 6543). Transaction mode loses session state between
# transactions and does not support prepared statements, which breaks the Outbox
# claim pattern (a held transaction across SELECT ... FOR UPDATE SKIP LOCKED and
# its follow-up writes). On the Free plan the direct connection is IPv6-only,
# so the session-mode pooler is also the IPv4-reachable option.
#
# Pooled usernames carry the project reference after a dot: app_api.<project-ref>
# =============================================================================

NODE_ENV=development
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# API runtime identity (app_api). Least privilege.
# Amendment 001 invariant I12: this role must never hold INSERT on the
# organization or authorization-policy-version tables.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://app_api.YOUR_PROJECT_REF:APP_API_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# -----------------------------------------------------------------------------
# Worker runtime identity. OPTIONAL — defaults to DATABASE_URL, since the worker
# shares the app_api identity. Set it only to give the worker its own pooled
# connection. Must also be session mode.
# -----------------------------------------------------------------------------
# WORKER_DATABASE_URL=postgresql://app_api.YOUR_PROJECT_REF:APP_API_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# -----------------------------------------------------------------------------
# Migration authority (app_migrator). Used only by `npm run migrate`.
#
# NOTE: migration 0001 creates database roles and therefore needs an authority
# that can CREATE ROLE. Apply it once with the project owner credential, then
# switch this variable to app_migrator for subsequent migrations.
# -----------------------------------------------------------------------------
# MIGRATION_DATABASE_URL=postgresql://app_migrator.YOUR_PROJECT_REF:APP_MIGRATOR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# -----------------------------------------------------------------------------
# Provisioner authority (app_provisioner) — SEPARATE CREDENTIAL.
#
# Used only by operator-invoked genesis entrypoints (`policy.bootstrap`,
# `organization.provision` — Phase 0C). The API process must never be given
# this value; startup refuses it.
# -----------------------------------------------------------------------------
# PROVISIONER_DATABASE_URL=postgresql://app_provisioner.YOUR_PROJECT_REF:APP_PROVISIONER_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# -----------------------------------------------------------------------------
# Supabase Auth — identity verification only.
#
# The backend verifies JWTs against the public JWKS endpoint. It needs NO
# service-role key and NO shared JWT secret: verification uses public keys, and
# database access uses the PostgreSQL roles above.
#
# The project reference is not a secret — it appears in these URLs.
#
# REQUIRES ASYMMETRIC SIGNING KEYS. The verifier accepts RS256/ES256 only and
# rejects `alg: none` and HS256. A project still using the legacy shared secret
# publishes no keys at the JWKS endpoint, and every token will be rejected.
# -----------------------------------------------------------------------------
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated

# -----------------------------------------------------------------------------
# Process configuration
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8080
WORKER_HEARTBEAT_INTERVAL_MS=30000

# -----------------------------------------------------------------------------
# Tests only. When set, the integration suite uses this PostgreSQL instead of
# starting a Testcontainers one. Never point this at a real environment.
# -----------------------------------------------------------------------------
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
