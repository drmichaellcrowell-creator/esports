# =============================================================================
# Frontend configuration — NAMES AND PLACEHOLDERS ONLY.
#
# Everything here is PUBLIC: Vite inlines VITE_* variables into the browser
# bundle. No database credential, no Supabase service-role key, no Base44
# workspace key, and no backend secret may ever appear in this file or in any
# VITE_* variable. CI fails the build if one does.
#
# The browser has no direct access to application tables (Option B). All data
# reaches the frontend through controlled operations, never through entity
# access. See docs/architecture/base44-implementation-profile-v1.md.
# =============================================================================

# The Base44 app id. Public by nature — it is visible in the app editor's own
# URL — and is the only value the browser needs to reach backend functions.
#
# When unset, the application shell renders and every operation fails closed as
# `unavailable`. That is the expected state for a preview with no backend.
VITE_BASE44_APP_ID=

# Optional. Points the SDK at a local Base44 development server instead of the
# hosted backend. Leave unset for ordinary use.
VITE_BASE44_SERVER_URL=

# Base URL of the PostgreSQL Reference Profile backend API. That profile is
# preserved and dormant (docs/architecture/reference-profile-status.md); no v1
# feature calls it, and no hybrid runtime is authorized.
VITE_API_BASE_URL=http://localhost:8080
