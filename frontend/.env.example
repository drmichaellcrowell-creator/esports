# =============================================================================
# Frontend configuration — NAMES AND PLACEHOLDERS ONLY.
#
# Everything here is PUBLIC: Vite inlines VITE_* variables into the browser
# bundle. No database credential, no Supabase service-role key, and no backend
# secret may ever appear in this file or in any VITE_* variable.
#
# The browser has no direct access to application tables (Option B). All data
# reaches the frontend through the backend API.
# =============================================================================

# Base URL of the backend API. When unset, the Base44 preview renders the
# application shell only, which is expected and acceptable for a preview.
VITE_API_BASE_URL=http://localhost:8080
